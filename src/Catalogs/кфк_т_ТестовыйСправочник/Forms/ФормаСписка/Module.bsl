// @strict-types

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПараметрыРазмещения = ПодключаемыеКоманды.ПараметрыРазмещения();
	ПараметрыРазмещения.КоманднаяПанель = Элементы.СписокКонтекстноеМеню;
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект, ПараметрыРазмещения);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписок

&НаКлиенте
Процедура СписокПриАктивизацииСтроки(Элемент)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Асинх Процедура СгенерироватьТестовыеДанные(Команда)
	
	ОчиститьСообщения();
	
	Количество = Ждать ВвестиЧислоАсинх(10, НСтр("ru = 'Сколько элементов создать?'"), 32, 0);
	Если Количество = Неопределено Или Количество = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.Заголовок = НСтр("ru = 'Заполнение текстового справочника'");
	ДлительныеОперацииКлиент.ОжидатьЗавершение(
		СгенерироватьДанныеВФоне(Количество),
		Новый ОписаниеОповещения("ЗавершитьЗаполнение", ЭтотОбъект),
		ПараметрыОжидания);
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура СкриптСозданияТестовыхДанных(Команда)
	
	ОчиститьСообщения();
	
	Количество = Ждать ВвестиЧислоАсинх(10, НСтр("ru = 'Сколько тысяч элементов создать?'"), 32, 0);
	Если Количество = Неопределено Или Количество = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.Заголовок = НСтр("ru = 'Формирование SQL-скрипта создания тестовых данных'");
	ДлительныеОперацииКлиент.ОжидатьЗавершение(
		СкриптСозданияТестовыхДанныхВФоне(УникальныйИдентификатор, Количество * 1000),
		Новый ОписаниеОповещения("ЗавершитьСозданиеСкрипта", ЭтотОбъект),
		ПараметрыОжидания);
		
КонецПроцедуры

&НаКлиенте
Асинх Процедура СкриптОчисткиТестовыхДанных(Команда)
	
	ОчиститьСообщения();
	
	Ответ = Ждать ВопросАсинх(
		НСтр("ru = 'Скрипт удалит все записи справочника. Сформировать?'"), РежимДиалогаВопрос.ДаНет); // КодВозвратаДиалога
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.Заголовок = НСтр("ru = 'Формирование SQL-скрипта очистки тестовых данных'");
	ДлительныеОперацииКлиент.ОжидатьЗавершение(
		СкриптОчисткиТестовыхДанныхВФоне(УникальныйИдентификатор),
		Новый ОписаниеОповещения("ЗавершитьСозданиеСкрипта", ЭтотОбъект),
		ПараметрыОжидания);
	
КонецПроцедуры

&НаКлиенте
Процедура ИсторияВыгрузки(Команда)
	
	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	//@skip-check undefined-variable
	//@skip-check dynamic-access-method-not-found
	кфкИнтеграцияКлиент.ИсторияВыгрузкиОбъекта(ТекущиеДанные.Ссылка, ЭтотОбъект);
	
КонецПроцедуры

//@skip-check method-param-value-type
//@skip-check module-structure-form-event-regions
#Область ПодключаемыеКоманды

// СтандартныеПодсистемы.ПодключаемыеКоманды
&НаКлиенте
Процедура Подключаемый_ВыполнитьКоманду(Команда)
	ПодключаемыеКомандыКлиент.НачатьВыполнениеКоманды(ЭтотОбъект, Команда, Элементы.Список);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПродолжитьВыполнениеКомандыНаСервере(ПараметрыВыполнения, ДополнительныеПараметры) Экспорт
	ВыполнитьКомандуНаСервере(ПараметрыВыполнения);
КонецПроцедуры

&НаСервере
Процедура ВыполнитьКомандуНаСервере(ПараметрыВыполнения)
	ПодключаемыеКоманды.ВыполнитьКоманду(ЭтотОбъект, ПараметрыВыполнения, Элементы.Список);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОбновитьКоманды()
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Элементы.Список);
КонецПроцедуры
// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Завершить заполнение.
// 
// Параметры:
//  Результат - Структура - Результат:
//   * Статус - Строка - Статус
//   * ИнформацияОбОшибке - ИнформацияОбОшибке - Информация об ошибке
//  ДополнительныеПараметры - Структура - Дополнительные параметры
&НаКлиенте
Процедура ЗавершитьЗаполнение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
		
	ИначеЕсли Результат.Статус = "Ошибка" Тогда
		СтандартныеПодсистемыКлиент.ВывестиИнформациюОбОшибке(Результат.ИнформацияОбОшибке);
		Возврат;
		
	КонецЕсли;
	
	Элементы.Список.Обновить();
	
КонецПроцедуры

// Завершить заполнение.
// 
// Параметры:
//  Результат - Структура - Результат:
//   * Статус - Строка - Статус
//   * ИнформацияОбОшибке - ИнформацияОбОшибке - Информация об ошибке
//   * АдресРезультата - Строка - Адрес результата
//  ДополнительныеПараметры - Структура - Дополнительные параметры
&НаКлиенте
Асинх Процедура ЗавершитьСозданиеСкрипта(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
		
	ИначеЕсли Результат.Статус = "Ошибка" Тогда
		СтандартныеПодсистемыКлиент.ВывестиИнформациюОбОшибке(Результат.ИнформацияОбОшибке);
		Возврат;
		
	КонецЕсли;
	
	Если Не ЭтоАдресВременногоХранилища(Результат.АдресРезультата) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр("ru = 'Результат не содержит адреса временного хранилища'"));
		Возврат;
	КонецЕсли;
	
	ТелоСкрипта = ПолучитьИзВременногоХранилища(Результат.АдресРезультата); // Строка
	Если ПустаяСтрока(ТелоСкрипта) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Ошибка генерации скрипта'"));
		Возврат;
	КонецЕсли;
	
	Ждать СредстваБуфераОбмена.ПоместитьДанныеАсинх(
		Новый ЭлементБуфераОбмена(СтандартныйФорматДанныхБуфераОбмена.Текст, ТелоСкрипта));
	
	ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Скрипт скопирован в буфер обмена'"));
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СгенерироватьДанныеВФоне(Количество)
	
	Если Количество <= (РазмерПакета() * 1.5) Тогда
		Возврат ДлительныеОперации.ВыполнитьПроцедуру(,
			"Справочники.кфк_т_ТестовыйСправочник.СгенерироватьТестовыеДанные", Количество);
		
	Иначе

		Возврат ДлительныеОперации.ВыполнитьПроцедуруВНесколькоПотоков(
			"Справочники.кфк_т_ТестовыйСправочник.СгенерироватьТестовыеДанные",
			ДлительныеОперации.ПараметрыВыполненияПроцедуры(),
			СформироватьНаборПараметров(Количество));
			
	КонецЕсли;
	
КонецФункции

&НаСервереБезКонтекста
Функция СкриптСозданияТестовыхДанныхВФоне(Идентификатор, Количество)
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(Идентификатор);
	Возврат ДлительныеОперации.ВыполнитьФункцию(ПараметрыВыполнения,
		"Справочники.кфк_т_ТестовыйСправочник.СкриптГенерацииТестовыхДанных", Количество);
	
КонецФункции

&НаСервереБезКонтекста
Функция СкриптОчисткиТестовыхДанныхВФоне(Идентификатор)
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(Идентификатор);
	Возврат ДлительныеОперации.ВыполнитьФункцию(ПараметрыВыполнения,
		"Справочники.кфк_т_ТестовыйСправочник.СкриптОчисткиТестовыхДанных");
	
КонецФункции

&НаСервереБезКонтекста
Функция СформироватьНаборПараметров(Количество)
	
	Результат = Новый Соответствие;
	
	РазмерПакета = РазмерПакета();
	Остаток = Количество;
	Для Номер = 1 По Цел(Количество / РазмерПакета) + 1 Цикл
		
		Результат.Вставить(СтрШаблон("ГенерацияТестовогоСправочника_%1", XMLСтрока(Номер)),
			ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Мин(Остаток, РазмерПакета)));
		
		Остаток = Остаток - РазмерПакета;
		Если Остаток <= 0 Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция РазмерПакета()
	Возврат 5000;
КонецФункции

#КонецОбласти
