// Заполняет таблицу правил обработки данных.
//
// Параметры:
//  НаправлениеОбмена      - Строка - "Отправка" либо "Получение".
//  ПравилаОбработкиДанных - см. кфкОбменДаннымиXDTOСервер.ТаблицаПравилОбработкиДанных
// 
Процедура ЗаполнитьПравилаОбработкиДанных(НаправлениеОбмена, ПравилаОбработкиДанных) Экспорт
	Если НаправлениеОбмена = "Отправка" Тогда
		Если ПравилаОбработкиДанных.Колонки.Найти("ОчисткаДанных") = Неопределено Тогда
			ПравилаОбработкиДанных.Колонки.Добавить("ОчисткаДанных");
		КонецЕсли;
		ДобавитьПОД_Документ_ТестовыйДокумент_Отправка(ПравилаОбработкиДанных);
		ДобавитьПОД_РегистрНакопления_ТестовыйРегистрНакоп_Отправка(ПравилаОбработкиДанных);
		ДобавитьПОД_РегистрСведений_ТестовыйРегистрСведений_Отправка(ПравилаОбработкиДанных);
		ДобавитьПОД_РегистрСведений_ТестовыйРегистрСведенийПР_Отправка(ПравилаОбработкиДанных);
		ДобавитьПОД_Справочник_ТестовыйСправочник_Отправка(ПравилаОбработкиДанных);
	ИначеЕсли НаправлениеОбмена = "Получение" Тогда
		ДобавитьПОД_TestCatalogs_Получение(ПравилаОбработкиДанных);
		ДобавитьПОД_TestDocuments_Получение(ПравилаОбработкиДанных);
		ДобавитьПОД_TestInformationRegisters_Получение(ПравилаОбработкиДанных);
	КонецЕсли;
КонецПроцедуры
// Заполняет таблицу правил конвертации объектов.
//
// Параметры:
//  НаправлениеОбмена  - Строка - 'Отправка' либо 'Получение'.
//  ПравилаКонвертации - ТаблицаЗначений - таблица значений, в которую будут добавлены правила.
// 
Процедура ЗаполнитьПравилаКонвертацииОбъектов(НаправлениеОбмена, ПравилаКонвертации) Экспорт
	Если НаправлениеОбмена = "Отправка" Тогда
		ДобавитьПКО_РегистрНакопления_ТестовыйРегистрНакоп_Отправка(ПравилаКонвертации);
		ДобавитьПКО_РегистрСведений_ТестовыйРегистрСведенийПР_Отправка(ПравилаКонвертации);
	КонецЕсли;
	ДобавитьПКО_Документ_ТестовыйДокумент(ПравилаКонвертации);
	ДобавитьПКО_РегистрСведений_ТестовыйРегистрСведений(ПравилаКонвертации);
	ДобавитьПКО_Справочник_ТестовыйСправочник(ПравилаКонвертации);
КонецПроцедуры
#Область ПКПД
// Заполняет таблицу правил конвертации предопределенных данных.
//
// Параметры:
//  НаправлениеОбмена  - Строка - 'Отправка' либо 'Получение'.
//  ПравилаКонвертации - ТаблицаЗначений - таблица значений, в которую будут добавлены правила. 
Процедура ЗаполнитьПравилаКонвертацииПредопределенныхДанных(НаправлениеОбмена, ПравилаКонвертации) Экспорт

	// Перечисление_ТестовоеПеречисление.
	ПравилоКонвертации           = ПравилаКонвертации.Добавить();
	ПравилоКонвертации.ИмяПКПД   = "Перечисление_ТестовоеПеречисление";
	ПравилоКонвертации.ТипДанных = Метаданные.Перечисления.кфк_т_ТестовоеПеречисление;
	ПравилоКонвертации.ТипXDTO   = "EnumerationEnum";

	ЗначенияДляОтправки = Новый Соответствие;
	ЗначенияДляОтправки.Вставить(Перечисления.кфк_т_ТестовоеПеречисление.Значение1, "Значение1");
	ЗначенияДляОтправки.Вставить(Перечисления.кфк_т_ТестовоеПеречисление.Значение2, "Значение2");
	ЗначенияДляОтправки.Вставить(Перечисления.кфк_т_ТестовоеПеречисление.Значение3, "Значение3");
	ПравилоКонвертации.КонвертацииЗначенийПриОтправке = ЗначенияДляОтправки;
	ЗначенияДляПолучения = Новый Соответствие;
	ЗначенияДляПолучения.Вставить("Значение1", Перечисления.кфк_т_ТестовоеПеречисление.Значение1);
	ЗначенияДляПолучения.Вставить("Значение2", Перечисления.кфк_т_ТестовоеПеречисление.Значение2);
	ЗначенияДляПолучения.Вставить("Значение3", Перечисления.кфк_т_ТестовоеПеречисление.Значение3);
	ПравилоКонвертации.КонвертацииЗначенийПриПолучении = ЗначенияДляПолучения;

КонецПроцедуры
#КонецОбласти

