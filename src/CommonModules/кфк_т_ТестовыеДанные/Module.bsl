#Область Пользователи

Функция СвойстваАдминистратораKafka()
	
	Свойства = СвойстваПользователяKafka();
	Свойства.Имя = НСтр("ru = 'АдминистраторKafka'");
	Свойства.ПолноеИмя = НСтр("ru = 'Администратор Kafka'");
	Свойства.Роли.Добавить("кфкПолныеПрава");
	ОбщегоНазначенияКлиентСервер.УдалитьЗначениеИзМассива(Свойства.Роли, "кфкБазовыеПрава");
	
	Возврат Свойства;
	
КонецФункции

Функция СвойстваПользователяKafka()
	
	Свойства = Пользователи.НовоеОписаниеПользователяИБ(Ложь, Ложь);
	Свойства.Имя = НСтр("ru = 'ПользовательKafka'");
	Свойства.ПолноеИмя = НСтр("ru = 'Пользователь Kafka'");
	Свойства.АутентификацияСтандартная = Истина;
	Свойства.ПоказыватьВСпискеВыбора = Истина;
	Свойства.Пароль = "";
	Свойства.ЗащитаОтОпасныхДействий = Ложь;
	
	Роли = Свойства.Роли;
	
//	Использование 1С:Предприятия.
	Роли.Добавить("ЗапускВебКлиента");
	Роли.Добавить("ЗапускТолстогоКлиента");
	Роли.Добавить("ЗапускТонкогоКлиента");
	Роли.Добавить("ВыводНаПринтерФайлБуферОбмена");
	Роли.Добавить("СохранениеДанныхПользователя");
	Роли.Добавить("ИнтерактивноеОткрытиеВнешнихОтчетовИОбработок");
	
	// Использование программы.
	Роли.Добавить("БазовыеПраваБСП");
	Роли.Добавить("ПросмотрЖурналаРегистрации");
	Роли.Добавить("ПросмотрОписанияИзмененийПрограммы");
	
	// Типовые возможности.
	Роли.Добавить("ЧтениеВариантовОтчетов");
	Роли.Добавить("ДобавлениеИзменениеЛичныхВариантовОтчетов");
	
	// Основные возможности профиля.
	Роли.Добавить("кфкБазовыеПрава");
	Роли.Добавить("кфк_т_ДобавлениеИзменениеТестовыхДанных");
	
	Возврат Свойства;
	
КонецФункции

