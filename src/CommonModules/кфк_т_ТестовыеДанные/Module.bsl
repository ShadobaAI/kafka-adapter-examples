#Область СлужебныйПрограммныйИнтерфейс

Процедура ИнициализацияДанных() Экспорт

	Константы.кфкИспользоватьИнтеграцию.Установить(Истина);
	Константы.кфкИспользоватьПотоковыйРежим.Установить(Истина);

	Брокер = Брокер();

	Родитель = ПродюсерДЗ();
	ПродюсерСправочника(Брокер, Родитель);
	ПродюсерДокумента(Брокер, Родитель);
	ПродюсерРегистра(Брокер, Родитель);
	ПродюсерРегистраПР(Брокер, Родитель);
	ПродюсерРегистраРН(Брокер, Родитель);
	ОбщийПродюсер(Брокер, Родитель);

	Родитель = КонсьюмерДЗ();
	КонсьюмерСправочника(Брокер, Родитель);
	КонсьюмерДокумента(Брокер, Родитель);
	КонсьюмерРегистра(Брокер, Родитель);
	ОбщийКонсьюмер(Брокер, Родитель);

КонецПроцедуры

Процедура ИнициализацияПользователей() Экспорт
	
	// Администратор
	Пользователь = Пользователи.СоздатьАдминистратора();
	ПользовательИБ = Пользователи.НайтиПоСсылке(Пользователь);
	ПользовательИБ.ЗащитаОтОпасныхДействий.ПредупреждатьОбОпасныхДействиях = Ложь;
	ПользовательИБ.Записать();
	Пользователи.УстановитьПравоОткрытияВнешнихОтчетовИОбработок(Истина);
	
	// АдминистраторТакси
	Свойства = Пользователи.СвойстваПользователяИБ(ПользовательИБ.УникальныйИдентификатор); // Копирует свойства администратора
	Свойства.Имя = НСтр("ru = 'АдминистраторТакси'");
	Свойства.ПолноеИмя = НСтр("ru = 'Администратор (Такси)'");
	Пользователи.СлужебныйПользовательИБ(Свойства);
	ОтключитьПредупреждениеБезопасности(Свойства.Имя);
	ПользователиСлужебный.УстановитьНачальныеНастройки(Свойства.Имя);
	
	// Администратор Kafka
	Свойства = СвойстваАдминистратораKafka();
	Пользователи.СлужебныйПользовательИБ(Свойства);
	ОтключитьПредупреждениеБезопасности(Свойства.Имя);
	
	// Пользователь Kafka
	Свойства = СвойстваПользователяKafka();
	Пользователи.СлужебныйПользовательИБ(Свойства);
	ОтключитьПредупреждениеБезопасности(Свойства.Имя);
	
	// Снимаем флаг служебного пользователя у всех пользователей
	Запрос = Новый Запрос("ВЫБРАТЬ Справочник.Пользователи.Ссылка
	|ГДЕ Служебный = ИСТИНА И ИдентификаторПользователяИБ <> &ПустойИдентификатор");
	Запрос.УстановитьПараметр("ПустойИдентификатор", ОбщегоНазначенияКлиентСервер.ПустойУникальныйИдентификатор());
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Объект = Выборка.Ссылка.ПолучитьОбъект(); // СправочникОбъект.Пользователи
		Объект.Служебный = Ложь;
		ОбновлениеИнформационнойБазы.ЗаписатьДанные(Объект, Ложь, Ложь);
	КонецЦикла;
	
КонецПроцедуры

